{
  "version": 2,
  "functions": {
    "api/weather.js": { "runtime": "nodejs18.x" },
    "api/calendar.js": { "runtime": "nodejs18.x" }
  },
  "routes": [
    { "src": "/api/weather", "dest": "/api/weather.js" },
    { "src": "/api/calendar", "dest": "/api/calendar.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
